<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:show_buffering="when_playing" />

    <com.blive.tv.danmu.SimpleDanmuView
        android:id="@+id/simple_danmu_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#FF4081"
        android:visibility="visible" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 底部抽屉设置面板：分类行 + 选项行，不遮挡大部分画面 -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/panel_bottom_background"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 分类行（横向） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_category_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:padding="4dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- 选项行（横向，跟随分类行焦点切换） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_option_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:padding="4dp" />

    </LinearLayout>

    <include
        layout="@layout/room_info_overlay"
        android:id="@+id/room_info_overlay"/>

</FrameLayout>
